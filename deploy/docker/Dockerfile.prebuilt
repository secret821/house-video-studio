# Package an audited, frozen Linux release; never substitute the current local source tree.
ARG NODE_IMAGE=public.ecr.aws/docker/library/node:22.23.4-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da
FROM ${NODE_IMAGE} AS base
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates curl fontconfig fonts-noto-cjk fonts-liberation \
      libnss3 libdbus-1-3 libatk1.0-0 libgbm1 libasound2 libxrandr2 \
      libxkbcommon0 libxfixes3 libxcomposite1 libxdamage1 libatk-bridge2.0-0 \
      libpango-1.0-0 libcairo2 libcups2 libxshmfence1 \
      python3 python3-venv libsndfile1 espeak-ng \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm install --global pnpm@10.14.0

FROM base AS dependencies
ARG TARGETARCH
RUN test "$TARGETARCH" = amd64 || (echo 'Use a frozen linux/amd64 release.' >&2; exit 1)
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --prod --frozen-lockfile && pnpm exec remotion browser ensure

FROM base AS runtime
ARG ENABLE_ASR=0
ARG PIP_INDEX_URL=https://pypi.org/simple
LABEL org.opencontainers.image.title="house-video-studio"
ENV NODE_ENV=production \
    PORT=4340 \
    PREBUILT_VIDEO_BUNDLES=1 \
    STUDIO_TEMPORARY_MEDIA=1 \
    STUDIO_DB_CONFIG=/run/studio/mysql.json \
    STUDIO_SESSION_STORE=/var/lib/studio/sessions/sessions.json \
    STUDIO_SMART_CLEAN_DIR=/app/.runtime/smart-clean \
    STUDIO_COMPOSITOR_DIR=/app/.runtime/compositor \
    STUDIO_ASR_DIR=/app/.runtime/asr \
    NODE_OPTIONS=--max-old-space-size=768
COPY --from=dependencies /app/node_modules ./node_modules
COPY package.json pnpm-lock.yaml tsconfig.json next.config.mjs ./
COPY .next ./.next
COPY .video-bundles ./.video-bundles
COPY .runtime ./.runtime
COPY src ./src
COPY server ./server
COPY scripts ./scripts
COPY public ./public
COPY deploy/docker/entrypoint.sh /usr/local/bin/studio-entrypoint
RUN sha256sum --check .runtime/SHA256SUMS \
    && node --import tsx --input-type=module -e "import {getPrebuiltVideoBundle,VideoBundleKind} from './server/video-bundles.ts';getPrebuiltVideoBundle(VideoBundleKind.Photo,process.cwd());getPrebuiltVideoBundle(VideoBundleKind.Real,process.cwd())" \
    && node --import tsx scripts/setup-smart-clean.ts \
    && if [ "$ENABLE_ASR" = 1 ]; then PIP_INDEX_URL="$PIP_INDEX_URL" node --import tsx scripts/setup-asr.ts && rm -rf .runtime/asr/pip-cache; fi \
    && .runtime/compositor/ffmpeg -v error -f lavfi -i color=c=black:s=16x16:r=1 -frames:v 1 -f null - \
    && chmod -R a+rX /app \
    && mkdir -p /app/data /app/.next/cache /run/studio /var/lib/studio/sessions \
    && chown node:node /app/data /app/.next/cache /var/lib/studio/sessions \
    && chmod 0700 /app/data /var/lib/studio/sessions \
    && chmod 0755 /usr/local/bin/studio-entrypoint
USER node
ENTRYPOINT ["/usr/local/bin/studio-entrypoint"]
CMD ["node", "--expose-gc", "--import", "tsx", "server/index.ts", "--production"]
