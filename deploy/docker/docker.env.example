# Copy to deploy/docker/.env and set the NEW server's exact origin before startup.
PUBLIC_ORIGIN=https://studio.example.com
STUDIO_IMAGE=house-video-studio:local
STUDIO_PORT=4340
STUDIO_DATA_DIR=/opt/house-video-studio-docker/data
STUDIO_SESSION_DIR=/opt/house-video-studio-docker/private/sessions
STUDIO_AUTH_FILE=/opt/house-video-studio-docker/private/auth.json
STUDIO_CLOUD_CONFIG_FILE=/opt/house-video-studio-docker/private/cloud.env
# Candidate limits for a dedicated 4-vCPU/4-GiB server; not a benchmark or authorization to change the old server.
STUDIO_CPUS=3
STUDIO_MEMORY_LIMIT=2560m
STUDIO_NODE_HEAP_MIB=768
# Opt in only after benchmarking; supported integers 1..3, default/invalid = 1.
STUDIO_VIDEO_THREADS=1
STUDIO_WORKSPACE_LIMIT_MIB=5120
STUDIO_MIN_DISK_FREE_MIB=1024
